TOMTOM_API_KEY=

OCPI_BASE_URL=
OCPI_TOKEN=
OCPI_LOCATION_ENDPOINT=/locations
OCPI_STATUS_ENDPOINT=/status

OVERPASS_URL=https://overpass-api.de/api/interpreter
ROUTING_MODE=academic
ROUTING_ALGORITHM=dijkstra
OSRM_BASE_URL=

STATION_REFRESH_SECONDS=3600
LIVE_REFRESH_SECONDS=180
QUEUE_MODEL=occupancy_estimate
STATION_DATA_PATH=
VERIFIED_STATION_COORDINATES_PATH=
VERIFIED_ORIGIN_COORDINATES_PATH=
DEFAULT_BATTERY_CAPACITY_KWH=60
ENABLE_OSM_REFRESH=false

# Ranking weights (renormalised over the criteria that have data)
WEIGHT_TOTAL_TIME=0.55
WEIGHT_COST=0.15
WEIGHT_AVAILABILITY=0.10
WEIGHT_RELIABILITY=0.15
WEIGHT_RATING=0.05

# Stations that list no connector are kept, flagged "unverified" and scored x penalty
INCLUDE_UNVERIFIED_CONNECTORS=true
UNVERIFIED_CONNECTOR_PENALTY=0.85

# Fallback route estimate: road distance = straight line x circuity, at this speed
ROAD_CIRCUITY_FACTOR=1.3
FALLBACK_SPEED_KMH=30

# Reservations (in memory, single process)
RESERVATION_HOLD_MINUTES=10
RESERVATION_QUEUE_TTL_MINUTES=60
RESERVATION_MAX_QUEUE_PER_STATION=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
